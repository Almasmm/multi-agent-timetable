# Copy to .env and fill in. .env is git-ignored: API keys never go into the code.
# LLM: auto (Claude if credentials exist, else offline rules) | claude | offline
TT_LLM=auto
ANTHROPIC_API_KEY=
TT_LLM_MODEL=claude-opus-5-5

# Problem
TT_DATA=data/input.xlsx
TT_TERM=1
# TT_PROGRAMS=IT,SE
TT_STREAM=2
TT_GYM_CAPACITY=8
TT_ALLOW_SATURDAY=false

# Solver / limits
TT_SOLVER_SECONDS=25
TT_SOLVER_WORKERS=8
TT_CHUNK_GROUPS=60
TT_MAX_STEPS=150
TT_RUN_TIMEOUT=1800
TT_TOOL_RETRIES=2
TT_MAX_NEGOTIATION=4
