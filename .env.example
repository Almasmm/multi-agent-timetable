# Copy to .env and fill in. .env is git-ignored: API keys never go into the code.
# LLM provider: auto = OpenAI if OPENAI_API_KEY is set, else Claude if ANTHROPIC_API_KEY, else offline rules.
# Other values: openai | claude | offline
TT_LLM=auto
OPENAI_API_KEY=
TT_OPENAI_MODEL=gpt-5-mini
# If api.openai.com is blocked on your network (TLS reset), route the SDK through a proxy or relay:
# HTTPS_PROXY=http://127.0.0.1:1080
# OPENAI_BASE_URL=https://your-relay.example.com/v1
ANTHROPIC_API_KEY=
TT_LLM_MODEL=claude-opus-5-5

# Problem
TT_DATA=data/input.xlsx
TT_TERM=1
# TT_PROGRAMS=IT,SE
TT_STREAM=2
TT_GYM_CAPACITY=8
TT_ALLOW_SATURDAY=false

# Solver / limits
TT_SOLVER_SECONDS=25
TT_SOLVER_WORKERS=8
TT_CHUNK_GROUPS=60
TT_MAX_STEPS=150
TT_RUN_TIMEOUT=1800
TT_TOOL_RETRIES=2
TT_MAX_NEGOTIATION=4

# 24/7 service (autopilot): auto = resume the on/off state saved in runs/_service, on, off
TT_AUTOPILOT=auto
TT_AUTOPILOT_TICK=60
# First Monday of the term: .ics calendar export and the "live term" date (small changes only after it)
TT_TERM_START=2026-09-07
# Warm start: penalty for moving a class away from the published version (GA + CP-SAT)
TT_STABILITY_WEIGHT=6
