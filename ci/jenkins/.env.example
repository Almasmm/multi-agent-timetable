# Copy to ci/jenkins/.env (git-ignored). scripts/devops/up.ps1 creates it with a random admin password.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# Optional image push from main. Docker Hub -> Account settings -> Personal access tokens (Read & Write).
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
# Target repository, e.g. youruser/multi-agent-timetable. Empty = the push stage is skipped.
DOCKERHUB_REPO=
