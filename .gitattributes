# Preserve evidence bytes so SHA-256 hashes survive clone on any platform.
docs/evidence/** -text whitespace=cr-at-eol
# Scripts executed in Linux containers keep LF; PowerShell scripts keep CRLF.
*.sh text eol=lf
Jenkinsfile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
