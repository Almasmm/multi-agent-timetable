**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.coverage
reports/
build/
.env
.env.*
!.env.example
runs/
runs_*.log
data/uploads/
dataset-archive/
docs/
ci/
k8s/
scripts/
*.docx
*.pdf
Dockerfile
docker-compose*.yml
Jenkinsfile
